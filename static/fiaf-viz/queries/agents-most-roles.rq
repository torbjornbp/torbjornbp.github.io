# Names credited in the most distinct roles, for the list under
# People › Roles. Ranking on roles alone keeps this cheap: the distinct
# name/role pairs are the same intermediate result as role-pairs.rq, so the
# endpoint can reuse it. agent-role-works.rq adds the work counts for the
# names listed. Unlabelled names are left out, as in agents.rq.

PREFIX fiaf: <https://dev.fiafcore.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?agent ?name ?roles
WHERE {
  {
    SELECT ?agent (COUNT(?role) AS ?roles)
    WHERE {
      {
        SELECT DISTINCT ?agent ?role
        WHERE {
          VALUES ?workType { fiaf:MonographicWork fiaf:Work }
          ?work a ?workType .
          {{SCOPE_FILTER}}
          ?work fiaf:hasEvent/fiaf:hasActivity ?activity .
          ?activity a ?role ;
                    fiaf:hasAgent ?agent .
          FILTER(STRSTARTS(STR(?role), "https://dev.fiafcore.org/") && ?role != fiaf:Activity)
        }
      }
    }
    GROUP BY ?agent
    HAVING (COUNT(?role) > 1)
    ORDER BY DESC(?roles) ?agent
    LIMIT {{LIMIT}}
  }
  {
    SELECT ?agent (MIN(STR(?agentLabel)) AS ?name)
    WHERE {
      ?agent rdfs:label ?agentLabel .
      FILTER(STRLEN(STR(?agentLabel)) > 0)
    }
    GROUP BY ?agent
  }
}
ORDER BY DESC(?roles) ?name
