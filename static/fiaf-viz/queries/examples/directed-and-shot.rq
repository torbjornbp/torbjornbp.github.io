# Names credited as both director and cinematographer on the same work,
# with one of those works' titles as an example.

PREFIX fiaf: <https://dev.fiafcore.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?agent ?name (COUNT(DISTINCT ?work) AS ?works) (SAMPLE(?title) AS ?example)
WHERE {
  VALUES ?workType { fiaf:MonographicWork fiaf:Work }
  ?work a ?workType ;
        fiaf:hasTitle/fiaf:hasTitleValue ?title ;
        fiaf:hasEvent/fiaf:hasActivity ?directing, ?shooting .
  ?directing a fiaf:Director ;
             fiaf:hasAgent ?agent .
  ?shooting a fiaf:Cinematographer ;
            fiaf:hasAgent ?agent .
  ?agent rdfs:label ?name .
}
GROUP BY ?agent ?name
ORDER BY DESC(?works) ?name
LIMIT 100
