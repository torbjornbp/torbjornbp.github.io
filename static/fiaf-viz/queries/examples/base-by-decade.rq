# Items by film base (nitrate, acetate, polyester…) and the production
# decade of their work.

PREFIX fiaf: <https://dev.fiafcore.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?decade ?base (COUNT(DISTINCT ?item) AS ?items)
WHERE {
  VALUES ?workType { fiaf:MonographicWork fiaf:Work }
  ?work a ?workType ;
        fiaf:hasManifestation/fiaf:hasItem ?item ;
        fiaf:hasEvent ?event .
  ?item fiaf:hasBase ?baseClass .
  ?baseClass rdfs:label ?base .
  ?event a fiaf:ProductionEvent ;
         fiaf:hasDate ?date .
  BIND(SUBSTR(STR(?date), 1, 4) AS ?year)
  FILTER(REGEX(?year, "^[0-9]{4}$"))
  BIND(CONCAT(SUBSTR(?year, 1, 3), "0s") AS ?decade)
}
GROUP BY ?decade ?base
ORDER BY ?decade DESC(?items)
