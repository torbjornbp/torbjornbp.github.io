# Items in colour or black and white by production decade. The colour
# characteristic is a blank node typed fiaf:Colour or fiaf:BlackAndWhite.

PREFIX fiaf: <https://dev.fiafcore.org/>

SELECT ?decade
       (COUNT(DISTINCT ?colourItem) AS ?colour)
       (COUNT(DISTINCT ?blackAndWhiteItem) AS ?blackAndWhite)
WHERE {
  VALUES ?workType { fiaf:MonographicWork fiaf:Work }
  ?work a ?workType ;
        fiaf:hasManifestation/fiaf:hasItem ?item ;
        fiaf:hasEvent ?event .
  ?item fiaf:hasColourCharacteristic ?characteristic .
  ?characteristic a ?kind .
  VALUES ?kind { fiaf:Colour fiaf:BlackAndWhite }
  ?event a fiaf:ProductionEvent ;
         fiaf:hasDate ?date .
  BIND(SUBSTR(STR(?date), 1, 4) AS ?year)
  FILTER(REGEX(?year, "^[0-9]{4}$"))
  BIND(CONCAT(SUBSTR(?year, 1, 3), "0s") AS ?decade)
  BIND(IF(?kind = fiaf:Colour, ?item, ?none) AS ?colourItem)
  BIND(IF(?kind = fiaf:BlackAndWhite, ?item, ?none) AS ?blackAndWhiteItem)
}
GROUP BY ?decade
ORDER BY ?decade
