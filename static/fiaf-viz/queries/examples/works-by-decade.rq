# Works per production decade. The year is the first four digits of the
# production event's date. Works without a dated production event are not
# counted.

PREFIX fiaf: <https://dev.fiafcore.org/>

SELECT ?decade (COUNT(DISTINCT ?work) AS ?works)
WHERE {
  VALUES ?workType { fiaf:MonographicWork fiaf:Work }
  ?work a ?workType ;
        fiaf:hasEvent ?event .
  ?event a fiaf:ProductionEvent ;
         fiaf:hasDate ?date .
  BIND(SUBSTR(STR(?date), 1, 4) AS ?year)
  FILTER(REGEX(?year, "^[0-9]{4}$"))
  BIND(CONCAT(SUBSTR(?year, 1, 3), "0s") AS ?decade)
}
GROUP BY ?decade
ORDER BY ?decade
