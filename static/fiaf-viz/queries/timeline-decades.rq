# Count a work once in each decade, even when it has several production years.
PREFIX fiaf: <https://dev.fiafcore.org/>

SELECT ?year (COUNT(DISTINCT ?work) AS ?works)
WHERE {
  VALUES ?workType { fiaf:MonographicWork fiaf:Work }
  ?work a ?workType .
  {{SCOPE_FILTER}}
  ?work fiaf:hasEvent ?event .
  ?event a fiaf:ProductionEvent ; fiaf:hasDate ?date .
  BIND(SUBSTR(STR(?date), 1, 4) AS ?productionYear)
  FILTER(REGEX(?productionYear, "^[0-9]{4}$"))
  BIND(CONCAT(SUBSTR(?productionYear, 1, 3), "0") AS ?year)
}
GROUP BY ?year
ORDER BY ?year
