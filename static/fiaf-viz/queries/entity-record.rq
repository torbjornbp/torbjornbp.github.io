# Identity and parent work for any record IRI reached from an expert query.
#
# The record inspector uses this to decide whether the IRI is a Work (open the
# full work drawer), a name (open the agent drawer) or another resource (show a
# generic property inspector). Parent work links let variants, manifestations,
# items and carriers lead back to their work.
#
# QLever plans the right side of an OPTIONAL on its own, so only a single
# triple pattern there is joined cheaply to the rows before it; a property
# path, nested OPTIONAL, BIND or UNION is evaluated for the whole graph first.
# So every OPTIONAL here is one triple pattern. A lookup one step further (a
# title's value, an identifier's authority) is a single-triple OPTIONAL on a
# key that falls back to <urn:fiaf-viz:none>, a node with no triples; an
# unbound key would match every triple in the graph instead. Computed values
# are bound after the OPTIONALs, never inside them.

PREFIX fiaf: <https://dev.fiafcore.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?type ?label ?identifier ?authority ?authorityLabel
       ?parentWork ?parentWorkLabel
WHERE {
  VALUES ?entity { {{ENTITY}} }

  OPTIONAL { ?entity a ?type }
  OPTIONAL { ?entity rdfs:label ?entityLabel }
  OPTIONAL { ?entity fiaf:hasTitle ?titleNode }
  OPTIONAL { ?entity fiaf:hasIdentifier ?identifierNode }

  BIND(COALESCE(?titleNode, <urn:fiaf-viz:none>) AS ?titleKey)
  BIND(COALESCE(?identifierNode, <urn:fiaf-viz:none>) AS ?identifierKey)
  OPTIONAL { ?titleKey fiaf:hasTitleValue ?entityTitle }
  OPTIONAL { ?identifierKey fiaf:hasIdentifierValue ?identifierValue }
  OPTIONAL { ?identifierKey fiaf:hasIdentifierAuthority ?authority }

  BIND(COALESCE(?authority, <urn:fiaf-viz:none>) AS ?authorityKey)
  OPTIONAL { ?authorityKey rdfs:label ?authorityLabel }

  BIND(COALESCE(?entityLabel, ?entityTitle) AS ?label)
  BIND(COALESCE(?identifierValue, STR(?identifierNode)) AS ?identifier)

  # A manifestation may hang off a Variant of the work, so each path has a
  # variant twin. Every branch starts from VALUES so QLever starts from the
  # entity; a work-type check (not FILTER NOT EXISTS) keeps out non-works.
  OPTIONAL {
    SELECT ?entity ?parentWork ?parentWorkLabel
    WHERE {
      VALUES ?parentType { fiaf:MonographicWork fiaf:Work }
      { VALUES ?entity { {{ENTITY}} } ?parentWork fiaf:hasManifestation ?entity . }
      UNION { VALUES ?entity { {{ENTITY}} } ?parentWork fiaf:hasManifestation/fiaf:hasItem ?entity . }
      UNION { VALUES ?entity { {{ENTITY}} } ?parentWork fiaf:hasManifestation/fiaf:hasItem/fiaf:hasCarrier ?entity . }
      UNION { VALUES ?entity { {{ENTITY}} } ?parentWork fiaf:hasEvent ?entity . }
      UNION { VALUES ?entity { {{ENTITY}} } ?parentWork fiaf:hasVariant ?entity . }
      UNION { VALUES ?entity { {{ENTITY}} } ?parentWork fiaf:hasVariant/fiaf:hasManifestation ?entity . }
      UNION { VALUES ?entity { {{ENTITY}} } ?parentWork fiaf:hasVariant/fiaf:hasManifestation/fiaf:hasItem ?entity . }
      UNION { VALUES ?entity { {{ENTITY}} } ?parentWork fiaf:hasVariant/fiaf:hasManifestation/fiaf:hasItem/fiaf:hasCarrier ?entity . }
      ?parentWork a ?parentType .

      OPTIONAL { ?parentWork rdfs:label ?parentLabel }
      OPTIONAL { ?parentWork fiaf:hasTitle ?parentTitleNode }
      BIND(COALESCE(?parentTitleNode, <urn:fiaf-viz:none>) AS ?parentTitleKey)
      OPTIONAL { ?parentTitleKey fiaf:hasTitleValue ?parentTitle }
      BIND(COALESCE(?parentLabel, ?parentTitle) AS ?parentWorkLabel)
    }
  }
}
LIMIT 100
