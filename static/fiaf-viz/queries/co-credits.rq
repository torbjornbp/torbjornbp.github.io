# Agent <-> agent co-credit edges (shared works) among the top names.

PREFIX fiaf: <https://dev.fiafcore.org/>

# Names are attached client-side from the agent page already in memory.
SELECT ?a ?b (COUNT(DISTINCT ?work) AS ?shared)
WHERE {
  # Deduplicate each side before pairing. Repeated activities, event links and
  # work types otherwise multiply each other before COUNT(DISTINCT ?work).
  {
    SELECT DISTINCT ?work ?a
    WHERE {
      VALUES ?a { {{AGENT_IRIS}} }
      VALUES ?workType { fiaf:MonographicWork fiaf:Work }
      ?work a ?workType .
      {{SCOPE_FILTER}}
      ?work fiaf:hasEvent/fiaf:hasActivity/fiaf:hasAgent ?a .
    }
  }
  {
    SELECT DISTINCT ?work ?b
    WHERE {
      VALUES ?b { {{AGENT_IRIS}} }
      VALUES ?workType { fiaf:MonographicWork fiaf:Work }
      ?work a ?workType .
      {{SCOPE_FILTER}}
      ?work fiaf:hasEvent/fiaf:hasActivity/fiaf:hasAgent ?b .
    }
  }
  # Keep each unordered pair once. QLever orders IRIs natively; comparing
  # STR(?a) < STR(?b) instead builds two strings per candidate pair and was 5x
  # slower, timing out past ~3,000 names. Standard SPARQL leaves IRI order
  # undefined, so the rdflib tests substitute the STR() form.
  FILTER(?a < ?b)
}
GROUP BY ?a ?b
HAVING (COUNT(DISTINCT ?work) >= {{MIN_SHARED}})
ORDER BY DESC(?shared)
LIMIT {{LIMIT}}
