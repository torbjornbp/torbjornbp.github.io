# Works for a timeline bar: a four-digit year ("1930") or a decade prefix
# ("193"), filtered on the four-digit production year prefix.

PREFIX fiaf: <https://dev.fiafcore.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?work (SAMPLE(?candidateTitle) AS ?title)
WHERE {
  VALUES ?workType { fiaf:MonographicWork fiaf:Work }
  ?work a ?workType ;
        fiaf:hasEvent ?event .
  {{SCOPE_FILTER}}
  ?event a fiaf:ProductionEvent ;
         fiaf:hasDate ?date .
  BIND(SUBSTR(STR(?date), 1, 4) AS ?year)
  FILTER(REGEX(?year, "^[0-9]{4}$"))
  FILTER(STRSTARTS(?year, {{YEAR_PREFIX}}))
  OPTIONAL { ?work rdfs:label ?label }
  OPTIONAL { ?work fiaf:hasTitle/fiaf:hasTitleValue ?titleValue }
  BIND(COALESCE(?label, ?titleValue) AS ?candidateTitle)
}
GROUP BY ?work
ORDER BY ?title ?work
LIMIT {{LIMIT}}
