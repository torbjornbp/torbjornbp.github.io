# Works per production country and number of attached items.
# Zero-item works are included so catalogue coverage is visible.

PREFIX fiaf: <https://dev.fiafcore.org/>

SELECT ?country ?bucket (COUNT(*) AS ?works)
WHERE {
  {
    SELECT ?country ?work (COUNT(DISTINCT ?item) AS ?itemCount)
    WHERE {
      VALUES ?workType { fiaf:MonographicWork fiaf:Work }
      ?work a ?workType ;
            fiaf:hasCountry ?country .
      {{SCOPE_FILTER}}
      OPTIONAL { ?work fiaf:hasManifestation/fiaf:hasItem ?item }
    }
    GROUP BY ?country ?work
  }
  BIND(
    IF(?itemCount = 0, "0",
    IF(?itemCount = 1, "1",
    IF(?itemCount <= 3, "2-3",
    IF(?itemCount <= 5, "4-5",
    IF(?itemCount <= 10, "6-10",
    IF(?itemCount <= 20, "11-20", "21+")))))) AS ?bucket
  )
}
GROUP BY ?country ?bucket
ORDER BY ?country ?bucket
