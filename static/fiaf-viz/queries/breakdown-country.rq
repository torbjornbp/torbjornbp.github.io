# Works per production country. A co-production counts under each country.

PREFIX fiaf: <https://dev.fiafcore.org/>

SELECT ?value (COUNT(DISTINCT ?work) AS ?n)
WHERE {
  VALUES ?workType { fiaf:MonographicWork fiaf:Work }
  ?work a ?workType ;
        fiaf:hasCountry ?value .
  {{SCOPE_FILTER}}
}
GROUP BY ?value
ORDER BY DESC(?n)
LIMIT {{LIMIT}}
