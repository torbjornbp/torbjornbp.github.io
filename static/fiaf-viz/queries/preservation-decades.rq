# Preservation copies by production decade.
#
# One row per decade and metric. "works" is the denominator for all dated works
# in the decade; "items" is the denominator for works with at least one recorded
# item. Works with production dates in several decades can appear in each
# decade, matching timeline-decades.rq.

PREFIX fiaf: <https://dev.fiafcore.org/>

SELECT ?decade ?metric (COUNT(DISTINCT ?work) AS ?n)
WHERE {
  VALUES ?workType { fiaf:MonographicWork fiaf:Work }
  ?work a ?workType ;
        fiaf:hasEvent ?event .
  ?event a fiaf:ProductionEvent ;
         fiaf:hasDate ?date .
  BIND(SUBSTR(STR(?date), 1, 4) AS ?year)
  FILTER(REGEX(?year, "^[0-9]{4}$"))
  BIND(CONCAT(SUBSTR(?year, 1, 3), "0") AS ?decade)
  {{SCOPE_FILTER}}
  {
    BIND("works" AS ?metric)
  }
  UNION
  {
    BIND("items" AS ?metric)
    ?work fiaf:hasManifestation/fiaf:hasItem ?itemsItem .
  }
  UNION
  {
    BIND("preservation" AS ?metric)
    ?work fiaf:hasManifestation/fiaf:hasItem ?preservationItem .
    ?preservationItem fiaf:hasStatus fiaf:Preservation .
  }
}
GROUP BY ?decade ?metric
ORDER BY ?decade ?metric
