# Items per film-stock manufacturer (the stock node's label).
#
# Each UNION branch carries its own path from the work to the item. Joining one
# shared work/item pattern with the whole UNION made the public endpoint time
# out on this query.

PREFIX fiaf: <https://dev.fiafcore.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?value (COUNT(DISTINCT ?item) AS ?n)
WHERE {
  VALUES ?workType { fiaf:MonographicWork fiaf:Work }
  ?work a ?workType .
  {{SCOPE_FILTER}}
  {
    ?work fiaf:hasManifestation/fiaf:hasItem ?item .
    ?item fiaf:hasStock ?stock .
  }
  UNION
  {
    ?work fiaf:hasManifestation ?manif .
    ?manif fiaf:hasStock ?stock ;
           fiaf:hasItem ?item .
  }
  ?item a fiaf:Item .
  ?stock rdfs:label ?value .
}
GROUP BY ?value
ORDER BY DESC(?n)
LIMIT {{LIMIT}}
