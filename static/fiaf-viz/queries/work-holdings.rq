# Holdings hierarchy for one work: manifestations, their items and carriers.
# Manifestations reached through a FIAF Variant are included; work-variants.rq
# says which variant each belongs to.
#
# One row is returned per manifestation/item/carrier combination. Multi-valued
# technical fields are aggregated into "|"-separated strings; the client groups
# the rows back into a tree. Blank-node colour and sound characteristics are
# resolved to their type (or nested sound standard), as in the facet queries.
#
# How this stays fast on QLever, which plans the right side of an OPTIONAL on
# its own: only a single triple pattern there is joined cheaply to the rows
# before it. A nested OPTIONAL, BIND, FILTER or UNION is evaluated for the
# whole graph (about 1M identifier rows) before it meets this work.
#
# - Each level is a subquery that starts from VALUES ?work, in every UNION
#   branch, with required patterns down to the manifestation or item.
# - Every OPTIONAL is one triple pattern. Each costs about the same whatever
#   it matches, so a record's own fields come from one `?record ?p ?o`
#   lookup, one row per triple, and each field picks its predicate's rows.
# - A lookup one step further (an identifier's value, a blank node's type) is
#   a single-triple OPTIONAL on a key: the object when the row's predicate
#   needs that lookup, otherwise <urn:fiaf-viz:none>, a node with no triples.
#   An unbound key would match every triple in the graph instead.
# - Computed values are bound after the OPTIONALs, never inside them.
#
# Aggregates take COALESCE(…, "") because on QLever one unbound value makes
# SAMPLE or GROUP_CONCAT unbound for the whole group. A list therefore holds
# one empty part for the rows of other predicates, which CLEAN removes:
#   REPLACE(REPLACE(list, "^\\||\\|$", ""), "\\|\\|", "|")
# rdflib (the tests) groups an empty match into one group with no key, so
# each subquery keeps only groups whose key is bound.

PREFIX fiaf: <https://dev.fiafcore.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT
  ?manifestation ?manifestationType ?manifestationLabel
  ?manifestationIdentifiers ?manifestationLanguages ?manifestationRatings
  # A manifestation without items gets "" in the item and carrier fields.
  ?item
  (COALESCE(?itemLabelValue, "") AS ?itemLabel)
  (COALESCE(?itemIdentifiersValue, "") AS ?itemIdentifiers)
  (COALESCE(?itemFormatsValue, "") AS ?itemFormats)
  (COALESCE(?itemElementsValue, "") AS ?itemElements)
  (COALESCE(?itemBasesValue, "") AS ?itemBases)
  (COALESCE(?itemColoursValue, "") AS ?itemColours)
  (COALESCE(?itemSoundsValue, "") AS ?itemSounds)
  (COALESCE(?itemStocksValue, "") AS ?itemStocks)
  (COALESCE(?itemStatusesValue, "") AS ?itemStatuses)
  (COALESCE(?itemInstitutionsValue, "") AS ?itemInstitutions)
  ?carrier
  (COALESCE(?carrierLabelValue, "") AS ?carrierLabel)
  (COALESCE(?carrierIdentifiersValue, "") AS ?carrierIdentifiers)
WHERE {
  # Manifestations and their fields, one row each. GROUP BY also merges a
  # manifestation reached both directly and through a Variant.
  {
    SELECT ?manifestation
           (COALESCE(SAMPLE(?type), "") AS ?manifestationType)
           (COALESCE(SAMPLE(?label), "") AS ?manifestationLabel)
           # CLEAN(list), see above.
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?identifierText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?manifestationIdentifiers)
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?languageText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?manifestationLanguages)
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?ratingText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?manifestationRatings)
    WHERE {
      VALUES ?workType { fiaf:MonographicWork fiaf:Work }
      {
        VALUES ?work { {{WORK}} }
        ?work a ?workType ;
              fiaf:hasManifestation ?manifestation .
      }
      UNION
      {
        VALUES ?work { {{WORK}} }
        ?work a ?workType ;
              fiaf:hasVariant ?variant .
        ?variant fiaf:hasManifestation ?manifestation .
      }

      # Single values: their own lookups, so SAMPLE sees them on every row.
      OPTIONAL { ?manifestation a ?type }
      OPTIONAL { ?manifestation rdfs:label ?label }
      # Every other triple of the manifestation.
      OPTIONAL { ?manifestation ?p ?o }

      BIND(COALESCE(IF(?p = fiaf:hasIdentifier, ?o, ?unset), <urn:fiaf-viz:none>) AS ?valueKey)
      BIND(COALESCE(IF(?p IN (fiaf:hasLanguageUsage, fiaf:hasEvent), ?o, ?unset), <urn:fiaf-viz:none>) AS ?typeKey)
      BIND(COALESCE(IF(?p = fiaf:hasLanguageUsage, ?o, ?unset), <urn:fiaf-viz:none>) AS ?languageKey)
      BIND(COALESCE(IF(?p = fiaf:hasEvent, ?o, ?unset), <urn:fiaf-viz:none>) AS ?verdictKey)

      OPTIONAL { ?valueKey fiaf:hasIdentifierValue ?identifierValue }
      OPTIONAL { ?typeKey a ?objectType }
      OPTIONAL { ?languageKey fiaf:hasLanguage ?language }
      OPTIONAL { ?verdictKey fiaf:hasVerdict ?verdict }

      BIND(IF(?p = fiaf:hasIdentifier, COALESCE(?identifierValue, STR(?o)), ?unset) AS ?identifierText)
      # language~UsageType, as in work-metadata.rq; unbound unless both exist.
      BIND(IF(?p = fiaf:hasLanguageUsage,
              CONCAT(STR(?language), "~", STRAFTER(STR(?objectType), "https://dev.fiafcore.org/")),
              ?unset) AS ?languageText)
      BIND(IF(?p = fiaf:hasEvent && ?objectType = fiaf:RatingEvent, STR(?verdict), ?unset) AS ?ratingText)
    }
    GROUP BY ?manifestation
    HAVING (BOUND(?manifestation))
  }

  # Items, their carriers, and both levels' fields, one row per
  # manifestation/item/carrier. Joined on the manifestation, which the rows
  # above always bind; a manifestation without items keeps its one row. The
  # work-type check keeps this empty for a non-work IRI, as the rows above are.
  OPTIONAL {
    SELECT ?manifestation ?item ?carrier
           (COALESCE(SAMPLE(?itemLabelRaw), "") AS ?itemLabelValue)
           # CLEAN(list), see above.
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?itemIdentifierText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?itemIdentifiersValue)
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?formatText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?itemFormatsValue)
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?elementText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?itemElementsValue)
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?baseText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?itemBasesValue)
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?colourText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?itemColoursValue)
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?soundText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?itemSoundsValue)
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?stockText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?itemStocksValue)
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?statusText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?itemStatusesValue)
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?institutionText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?itemInstitutionsValue)
           (COALESCE(SAMPLE(?carrierLabelRaw), "") AS ?carrierLabelValue)
           (REPLACE(REPLACE(GROUP_CONCAT(DISTINCT COALESCE(?carrierIdentifierText, ""); separator="|"), "^\\||\\|$", ""), "\\|\\|", "|") AS ?carrierIdentifiersValue)
    WHERE {
      VALUES ?workType { fiaf:MonographicWork fiaf:Work }
      { VALUES ?work { {{WORK}} } ?work a ?workType ; fiaf:hasManifestation ?manifestation . }
      UNION
      { VALUES ?work { {{WORK}} } ?work a ?workType ; fiaf:hasVariant ?variant . ?variant fiaf:hasManifestation ?manifestation . }
      ?manifestation fiaf:hasItem ?item .

      # The carrier is a row key and the label a single value, so both have
      # their own lookups; every other triple of the item comes from ?p ?o.
      OPTIONAL { ?item fiaf:hasCarrier ?carrier }
      OPTIONAL { ?item rdfs:label ?itemLabelRaw }
      OPTIONAL { ?item ?p ?o }

      BIND(COALESCE(IF(?p = fiaf:hasIdentifier, ?o, ?unset), <urn:fiaf-viz:none>) AS ?valueKey)
      BIND(COALESCE(IF(?p IN (fiaf:hasFormat, fiaf:hasColourCharacteristic, fiaf:hasSoundCharacteristic), ?o, ?unset), <urn:fiaf-viz:none>) AS ?typeKey)
      BIND(COALESCE(IF(?p = fiaf:hasSoundCharacteristic, ?o, ?unset), <urn:fiaf-viz:none>) AS ?standardKey)
      BIND(COALESCE(IF(?p IN (fiaf:hasStock, fiaf:hasHoldingInstitution), ?o, ?unset), <urn:fiaf-viz:none>) AS ?labelKey)
      BIND(COALESCE(?carrier, <urn:fiaf-viz:none>) AS ?carrierKey)

      OPTIONAL { ?valueKey fiaf:hasIdentifierValue ?identifierValue }
      OPTIONAL { ?typeKey a ?objectType }
      OPTIONAL { ?standardKey fiaf:hasSoundStandard ?soundStandard }
      OPTIONAL { ?labelKey rdfs:label ?objectLabel }
      OPTIONAL { ?carrierKey rdfs:label ?carrierLabelRaw }
      OPTIONAL { ?carrierKey fiaf:hasIdentifier ?carrierIdentifier }

      # The carrier's identifier value is one step further: key it the same way.
      BIND(COALESCE(?carrierIdentifier, <urn:fiaf-viz:none>) AS ?carrierValueKey)
      OPTIONAL { ?carrierValueKey fiaf:hasIdentifierValue ?carrierIdentifierValue }

      BIND(IF(?p = fiaf:hasIdentifier, COALESCE(?identifierValue, STR(?o)), ?unset) AS ?itemIdentifierText)
      # A blank format or colour node is shown by its type; an IRI by itself.
      BIND(IF(?p = fiaf:hasFormat, IF(isBlank(?o), STR(?objectType), STR(?o)), ?unset) AS ?formatText)
      BIND(IF(?p = fiaf:isElement, STR(?o), ?unset) AS ?elementText)
      BIND(IF(?p = fiaf:hasBase, STR(?o), ?unset) AS ?baseText)
      BIND(IF(?p = fiaf:hasColourCharacteristic, IF(isBlank(?o), STR(?objectType), STR(?o)), ?unset) AS ?colourText)
      # Skip unresolved blank sound nodes; their internal id is not a label.
      BIND(IF(?p = fiaf:hasSoundCharacteristic && (!isBlank(?o) || BOUND(?soundStandard) || BOUND(?objectType)),
              COALESCE(STR(?soundStandard), STR(?objectType), STR(?o)),
              ?unset) AS ?soundText)
      # Unlabelled blank stock nodes have no display name.
      BIND(IF(?p = fiaf:hasStock && (!isBlank(?o) || BOUND(?objectLabel)),
              COALESCE(?objectLabel, STR(?o)),
              ?unset) AS ?stockText)
      BIND(IF(?p = fiaf:hasStatus, STR(?o), ?unset) AS ?statusText)
      BIND(IF(?p = fiaf:hasHoldingInstitution, COALESCE(?objectLabel, STR(?o)), ?unset) AS ?institutionText)
      BIND(COALESCE(?carrierIdentifierValue, STR(?carrierIdentifier)) AS ?carrierIdentifierText)
    }
    GROUP BY ?manifestation ?item ?carrier
    HAVING (BOUND(?manifestation))
  }
}
ORDER BY ?manifestation ?item ?carrier
