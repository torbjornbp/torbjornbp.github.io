# Distinct works per production country and decade.

PREFIX fiaf: <https://dev.fiafcore.org/>

SELECT ?decade ?country (COUNT(DISTINCT ?work) AS ?works)
WHERE {
  VALUES ?workType { fiaf:MonographicWork fiaf:Work }
  ?work a ?workType ;
        fiaf:hasCountry ?country ;
        fiaf:hasEvent ?event .
  {{SCOPE_FILTER}}
  ?event a fiaf:ProductionEvent ;
         fiaf:hasDate ?date .
  BIND(SUBSTR(STR(?date), 1, 4) AS ?year)
  FILTER(REGEX(?year, "^[0-9]{4}$"))
  BIND(CONCAT(SUBSTR(?year, 1, 3), "0") AS ?decade)
}
GROUP BY ?decade ?country
ORDER BY ?country ?decade
