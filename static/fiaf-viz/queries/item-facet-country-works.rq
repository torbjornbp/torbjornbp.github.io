# Works for one item-facet/country heatmap cell.
#
# Keep this resolution in step with item-facet-countries.rq: match the item
# facet first, then the manifestation facet for its items.

PREFIX fiaf: <https://dev.fiafcore.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?work (SAMPLE(?candidateTitle) AS ?title)
WHERE {
  VALUES ?facet { {{FACET}} }
  VALUES ?country { {{COUNTRY}} }
  VALUES ?workType { fiaf:MonographicWork fiaf:Work }
  ?work a ?workType ;
        fiaf:hasCountry ?country .
  {{SCOPE_FILTER}}
  OPTIONAL { ?work rdfs:label ?label }
  OPTIONAL { ?work fiaf:hasTitle/fiaf:hasTitleValue ?titleValue }
  BIND(COALESCE(?label, ?titleValue) AS ?candidateTitle)
  {
    ?work fiaf:hasManifestation/fiaf:hasItem ?item .
    ?item ?facet ?rawValue .
  }
  UNION
  {
    ?work fiaf:hasManifestation ?manif .
    ?manif ?facet ?rawValue ;
           fiaf:hasItem ?item .
  }
  OPTIONAL { ?rawValue fiaf:hasSoundStandard ?soundStandard }
  OPTIONAL { ?rawValue fiaf:hasColourStandard ?colourStandard }
  OPTIONAL { ?rawValue a ?rawType . FILTER(isBlank(?rawValue)) }
  FILTER(!isBlank(?rawValue) || BOUND(?soundStandard) || BOUND(?colourStandard) || BOUND(?rawType))
  BIND(COALESCE(?soundStandard, ?colourStandard,
                IF(isBlank(?rawValue), ?rawType, ?rawValue)) AS ?value)
  FILTER(?value = {{FACET_VALUE}})
}
GROUP BY ?work
ORDER BY ?title ?work
LIMIT {{LIMIT}}
